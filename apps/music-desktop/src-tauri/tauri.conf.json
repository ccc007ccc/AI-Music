{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Music",
  "version": "0.1.0",
  "identifier": "com.aimusic.workspace",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Music",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.svg"]
  }
}
